# Client ID of your app in the Spotify Developer Dashboard.
# Add http://127.0.0.1:4200/callback (dev), https://<your-domain>/callback
# (production) and https://www.avol.io/spoticast/callback (beta, GitHub Pages)
# as redirect URIs in the dashboard.
VITE_SPOTIFY_CLIENT_ID=

# Base path the app is served from ("/" when it is the site root; the beta on
# GitHub Pages uses "/spoticast/").
VITE_BASE=/

# Release channel: "production" (default) or "beta" (beta name, icons and
# badge; deployed from every push to develop).
VITE_CHANNEL=production
