# Client ID of your app in the Spotify Developer Dashboard.
# Add http://127.0.0.1:4200/callback (dev), https://<your-domain>/callback
# (production) and https://beta.<your-domain>/callback (beta) as redirect URIs
# in the dashboard.
VITE_SPOTIFY_CLIENT_ID=

# Base path the app is served from ("/" when it is the site root).
VITE_BASE=/

# Release channel: "production" (default) or "beta" (beta name, icons and
# badge; deployed from GitHub pre-releases).
VITE_CHANNEL=production
